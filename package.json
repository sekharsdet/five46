{
  "name": "five46",
  "version": "0.1.0",
  "description": "BYOK, fully local agentic E2E and API testing: point five46 at a live URL or API and a goal, an LLM (your own OpenAI/Anthropic/Gemini/Groq/Bedrock key) drives a real local Playwright browser or real HTTP requests toward it, and writes a real, standalone, re-runnable Playwright/node:test spec on success. No cloud sandbox, no tunneling.",
  "homepage": "https://github.com/sekharsdet/five46#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sekharsdet/five46.git"
  },
  "bugs": {
    "url": "https://github.com/sekharsdet/five46/issues"
  },
  "author": "sekharsdet",
  "bin": {
    "five46": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/cli.ts",
    "test": "npm run build && node --test 'dist/**/*.test.js'",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "e2e",
    "e2e-testing",
    "end-to-end-testing",
    "testing",
    "test-automation",
    "api-testing",
    "playwright",
    "playwright-tests",
    "ai-agent",
    "ai-testing",
    "autonomous-testing",
    "agentic",
    "llm",
    "byok",
    "qa",
    "qa-automation",
    "cli",
    "mcp",
    "model-context-protocol",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "groq",
    "bedrock",
    "codegen",
    "test-generation",
    "self-healing-tests"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1095.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.0",
    "playwright": "^1.62.0",
    "zod": "^4.4.3"
  }
}
